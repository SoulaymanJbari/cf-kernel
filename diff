+        for (i = 0; i < count; i++) {
+            seq_printf(m, "%d 0x%lx 0x%lx\n",
+                       cpu,
+                       ring->entries[i].src,
+                       ring->entries[i].dst);
+        }
+    }
+    return 0;
+}
